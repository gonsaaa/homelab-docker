api:
  dashboard: true
  debug: true
  insecure: false #dashboard unsecured

entryPoints:
  http:
    address: :80

    http:
      aliasHeadersStrategy: reject

    forwardedHeaders:
      insecure: true

  https:
    address: :443

    http:
      aliasHeadersStrategy: reject

    forwardedHeaders:
      insecure: true

    transport:
      respondingTimeouts:
        readTimeout: 600s
        idleTimeout: 600s
        writeTimeout: 600s

  metrics:
    address: ":9100"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false

  file:
    directory: /conf
    watch: true

certificatesResolvers:
  cloudflare:
    acme:
      email: youremail@example.com
      storage: /conf/acme.json
      caServer: https://acme-v02.api.letsencrypt.org/directory # prod (default)
   #  caServer: https://acme-staging-v02.api.letsencrypt.org/directory # staging
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "1.0.0.1:53"
log:
  level: "INFO"
  filePath: "/var/log/traefik/traefik.log"
accessLog:
  filePath: "/var/log/traefik/access.log"
  format: json
  
tls:
  options:
    default:
    #Some very old devices, IoT hardware, or legacy software may not support TLS 1.2
      minVersion: VersionTLS12
      sniStrict: true
      
serversTransport:
  insecureSkipVerify: true

metrics:
  prometheus:
    entryPoint: metrics
    addEntryPointsLabels: true
    addServicesLabels: true
    manualRouting: false
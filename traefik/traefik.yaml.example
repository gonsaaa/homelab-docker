api:
  dashboard: true
  debug: true
  insecure: false #dashboard unsecured

experimental:
  plugins:
    bouncer:
      moduleName: github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
      version: v1.7.1

    geoblock:
      moduleName: github.com/PascalMinder/geoblock
      version: v0.3.8

entryPoints:
  http:
    address: :80

    http:
      aliasHeadersStrategy: reject
      middlewares:
        - crowdsec-plugin@file

    forwardedHeaders:
      trustedIPs: &trusted-proxies
        # Cloudflare Tunnel host
        - 192.168.1.147/32

        # Cloudflare IPv4 networks
        - 173.245.48.0/20
        - 103.21.244.0/22
        - 103.22.200.0/22
        - 103.31.4.0/22
        - 141.101.64.0/18
        - 108.162.192.0/18
        - 190.93.240.0/20
        - 188.114.96.0/20
        - 197.234.240.0/22
        - 198.41.128.0/17
        - 162.158.0.0/15
        - 104.16.0.0/13
        - 104.24.0.0/14
        - 172.64.0.0/13
        - 131.0.72.0/22




  https:
    address: :443

    forwardedHeaders:
      trustedIPs: *trusted-proxies

    http:
      aliasHeadersStrategy: reject
      middlewares:
        - crowdsec-plugin@file

    transport:
      respondingTimeouts:
        readTimeout: 600s
        idleTimeout: 600s
        writeTimeout: 600s

  metrics:
    address: ":9100"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false

  file:
    directory: /conf
    watch: true

certificatesResolvers:
  cloudflare:
    acme:
      email: your-email@example.com
      storage: /conf/acme.json
      caServer: https://acme-v02.api.letsencrypt.org/directory # prod (default)
    #  caServer: https://acme-staging-v02.api.letsencrypt.org/directory # staging
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "1.0.0.1:53"
log:
  level: "INFO"
  filePath: "/var/log/traefik/traefik.log"
accessLog:
  filePath: "/var/log/traefik/access.log"
  format: json
  fields:
    headers:
      defaultMode: drop
      names:
        CF-Connecting-IP: keep
        X-Forwarded-For: keep
        X-Real-Ip: keep
        CF-Ray: keep
tls:
  options:
    default:
    #Some very old devices, IoT hardware, or legacy software may not support TLS 1.2
      minVersion: VersionTLS12
      sniStrict: true
serversTransport:
  insecureSkipVerify: true

metrics:
  prometheus:
    entryPoint: metrics
    addEntryPointsLabels: true
    addServicesLabels: true
    manualRouting: false